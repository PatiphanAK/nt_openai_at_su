generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Adopts the table the old Go/GORM backend created. New profile columns
// (handle, major, year, bio, color) extend it; existing rows keep working.
model User {
  id         String    @id @db.VarChar(36)
  email      String    @unique(map: "idx_users_email") @db.VarChar(255)
  name       String    @db.VarChar(255)
  password   String    @db.VarChar(255)
  handle     String    @unique @db.VarChar(255)
  major      String    @default("") @db.VarChar(255)
  year       Int       @default(1)
  bio        String    @default("") @db.Text
  color      String    @default("from-indigo-500 to-violet-500") @db.VarChar(255)
  created_at DateTime? @db.Timestamptz(6) @map("created_at")
  updated_at DateTime? @db.Timestamptz(6) @updatedAt @map("updated_at")

  summaries Summary[]
  likes     Like[]
  saves     Save[]

  @@map("users")
}

model Course {
  id             String   @id @db.VarChar(36) // the course code, e.g. "CS201"
  code           String   @unique @db.VarChar(36)
  title          String   @db.VarChar(255)
  school         String   @db.VarChar(255)
  instructor     String   @db.VarChar(255)
  term           String   @db.VarChar(255)
  description    String   @db.Text
  requiredTopics String[] @map("required_topics")

  summaries Summary[]

  @@map("courses")
}

model Summary {
  id            String   @id @db.VarChar(36)
  slug          String   @unique @db.VarChar(80)
  title         String   @db.VarChar(255)
  course_id     String   @db.VarChar(36) @map("course_id")
  author_id     String   @db.VarChar(36) @map("author_id")
  created_at    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  format        String   @db.VarChar(20) // outline | bullets | narrative | qa | mindmap | flashcards
  depth         String   @db.VarChar(20) // quick-review | standard | deep-dive
  tone          String   @db.VarChar(20) // concise | friendly | academic
  hasExamples   Boolean  @default(false) @map("has_examples")
  hasFormulas   Boolean  @default(false) @map("has_formulas")
  hasDiagrams   Boolean  @default(false) @map("has_diagrams")
  topicsCovered String[] @map("topics_covered")
  sections      Json // [{ heading, body }]
  baseLikes     Int      @default(0) @map("base_likes")
  baseSaves     Int      @default(0) @map("base_saves")

  course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)
  author User   @relation(fields: [author_id], references: [id], onDelete: Cascade)

  likes Like[]
  saves Save[]

  @@index([course_id])
  @@index([author_id])
  @@map("summaries")
}

model Like {
  user_id    String   @db.VarChar(36) @map("user_id")
  summary_id String   @db.VarChar(36) @map("summary_id")
  created_at DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  summary Summary @relation(fields: [summary_id], references: [id], onDelete: Cascade)

  @@id([user_id, summary_id])
  @@map("likes")
}

model Save {
  user_id    String   @db.VarChar(36) @map("user_id")
  summary_id String   @db.VarChar(36) @map("summary_id")
  created_at DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  summary Summary @relation(fields: [summary_id], references: [id], onDelete: Cascade)

  @@id([user_id, summary_id])
  @@map("saves")
}
